// Cloudflare Workers (static assets only — no Worker script).
// Cloudflare's build runs `npx wrangler deploy` on every push to main.
{
  "name": "lsmat-site",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public"
  },
  // workers.dev stays on because preview URLs (non-main branches) depend on it.
  "workers_dev": true,
  "preview_urls": true,
  // Custom domains: Cloudflare creates the DNS records and certificates.
  // www is attached only so it has a DNS record; a Redirect Rule in the
  // lsmat.com zone (dashboard, not in this repo) sends it to lsmat.com.
  "routes": [
    { "pattern": "lsmat.com", "custom_domain": true },
    { "pattern": "www.lsmat.com", "custom_domain": true }
  ]
}
